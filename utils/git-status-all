#!/usr/bin/env bash
# Show git status summary for all repos under ~/Developer/{personal,msft}.
#
# Usage:
#   git-status-all              Show all repos with changes or ahead/behind
#   git-status-all --all        Show all repos including clean ones
#   git-status-all --fetch      Fetch remotes first (slower, accurate ahead/behind)

set -euo pipefail

DEV_DIR="$HOME/Developer"
SHOW_ALL=false
DO_FETCH=false

for arg in "$@"; do
  case "$arg" in
    --all|-a)   SHOW_ALL=true ;;
    --fetch|-f) DO_FETCH=true ;;
    --help|-h)
      echo "Usage: git-status-all [--all] [--fetch]"
      echo "  --all    Show all repos, including clean ones"
      echo "  --fetch  Fetch remotes first (slower but accurate ahead/behind)"
      exit 0
      ;;
    *) echo "Unknown option: $arg (try --help)"; exit 1 ;;
  esac
done

bold()  { printf '\033[1m%s\033[0m' "$*"; }
dim()   { printf '\033[2m%s\033[0m' "$*"; }
green() { printf '\033[32m%s\033[0m' "$*"; }
yellow(){ printf '\033[33m%s\033[0m' "$*"; }
red()   { printf '\033[31m%s\033[0m' "$*"; }

# Truncate string to max visible length, append … if cut
trunc() {
  local str="$1" max="$2"
  if [ "${#str}" -gt "$max" ]; then
    echo "${str:0:$((max - 1))}…"
  else
    echo "$str"
  fi
}

# Pad a colored string to a fixed visible width
# Usage: cpad <visible_width> <colored_string>
cpad() {
  local width="$1" str="$2"
  # Strip ANSI codes to measure visible length
  local plain
  plain=$(printf '%s' "$str" | sed $'s/\033\\[[0-9;]*m//g')
  local visible=${#plain}
  local pad=$((width - visible))
  if [ "$pad" -gt 0 ]; then
    printf '%s%*s' "$str" "$pad" ""
  else
    printf '%s' "$str"
  fi
}

MAX_REPO=24
MAX_BRANCH=20
clean_count=0
dirty_count=0

# Table header (use cpad for consistent alignment)
printf "\n"
header_sep_repo=$(printf '─%.0s' $(seq 1 $MAX_REPO))
header_sep_branch=$(printf '─%.0s' $(seq 1 $MAX_BRANCH))
printf "  %s %s %s %s %s %s %s  %s  %s\n" \
  "$(cpad $MAX_REPO "$(bold "Repo")")" \
  "$(cpad $MAX_BRANCH "$(bold "Branch")")" \
  "$(cpad 5 "$(bold "↑")")" \
  "$(cpad 5 "$(bold "↓")")" \
  "$(cpad 5 "$(bold "●")")" \
  "$(cpad 5 "$(bold "✎")")" \
  "$(cpad 5 "$(bold "?")")" \
  "$(cpad 10 "$(bold "Last Push")")" \
  "$(bold "Remote")"
printf "  %s %s %s %s %s %s %s  %s  %s\n" \
  "$header_sep_repo" "$header_sep_branch" "─────" "─────" "─────" "─────" "─────" "──────────" "──────────────────────────────"

for git_dir in "$DEV_DIR"/{personal,msft}/*/.git; do
  repo_dir="${git_dir%/.git}"
  repo_name="${repo_dir##*/}"

  cd "$repo_dir" || continue

  # Current branch
  branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo "detached")

  # Fetch if requested
  if [ "$DO_FETCH" = true ]; then
    git fetch --quiet 2>/dev/null || true
  fi

  # Ahead/behind
  upstream=$(git rev-parse --abbrev-ref "@{upstream}" 2>/dev/null) || upstream=""
  ahead=0
  behind=0
  if [ -n "$upstream" ]; then
    counts=$(git rev-list --left-right --count HEAD..."$upstream" 2>/dev/null) || counts="0	0"
    ahead=$(echo "$counts" | awk '{print $1}')
    behind=$(echo "$counts" | awk '{print $2}')
  fi

  # Working tree status
  staged=$(git diff --cached --numstat 2>/dev/null | wc -l | tr -d ' ')
  unstaged=$(git diff --numstat 2>/dev/null | wc -l | tr -d ' ')
  untracked=$(git ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')

  # Last push date — most recent commit on the remote tracking branch
  last_push=""
  if [ -n "$upstream" ]; then
    last_push=$(git log -1 --format="%cd" --date=format:"%Y-%m-%d" "$upstream" 2>/dev/null) || last_push=""
  fi
  [ -z "$last_push" ] && last_push="-"

  # Remote URL (short form)
  remote_url=$(git remote get-url origin 2>/dev/null) || remote_url=""
  # Strip to org/repo from GitHub URLs
  remote_url=$(echo "$remote_url" | sed -E 's|https://github\.com/||; s|git@github\.com:||; s|\.git$||')

  has_changes=false
  [[ "$ahead" -gt 0 || "$behind" -gt 0 || "$staged" -gt 0 || "$unstaged" -gt 0 || "$untracked" -gt 0 ]] && has_changes=true

  # Truncate names for alignment
  display_repo=$(trunc "$repo_name" "$MAX_REPO")
  display_branch=$(trunc "$branch" "$MAX_BRANCH")

  # Format cells with color (use ASCII . for empty to avoid multibyte issues)
  [[ "$ahead" -gt 0 ]]     && fmt_ahead=$(green "$ahead")        || fmt_ahead=$(dim ".")
  [[ "$behind" -gt 0 ]]    && fmt_behind=$(red "$behind")        || fmt_behind=$(dim ".")
  [[ "$staged" -gt 0 ]]    && fmt_staged=$(green "$staged")      || fmt_staged=$(dim ".")
  [[ "$unstaged" -gt 0 ]]  && fmt_unstaged=$(yellow "$unstaged") || fmt_unstaged=$(dim ".")
  [[ "$untracked" -gt 0 ]] && fmt_untracked=$(dim "$untracked")  || fmt_untracked=$(dim ".")

  if [ "$has_changes" = true ]; then
    dirty_count=$((dirty_count + 1))
  elif [ "$SHOW_ALL" = true ]; then
    clean_count=$((clean_count + 1))
    fmt_ahead=$(green "✔")
    fmt_behind="" fmt_staged="" fmt_unstaged="" fmt_untracked=""
  else
    clean_count=$((clean_count + 1))
    continue
  fi

  # Print row using cpad for reliable alignment
  printf "  %s %s %s %s %s %s %s  %s  %s\n" \
    "$(cpad $MAX_REPO "$(bold "$display_repo")")" \
    "$(cpad $MAX_BRANCH "$(dim "$display_branch")")" \
    "$(cpad 5 "$fmt_ahead")" \
    "$(cpad 5 "$fmt_behind")" \
    "$(cpad 5 "$fmt_staged")" \
    "$(cpad 5 "$fmt_unstaged")" \
    "$(cpad 5 "$fmt_untracked")" \
    "$(cpad 10 "$(dim "$last_push")")" \
    "$(dim "$remote_url")"
done

echo ""
if [ "$SHOW_ALL" = true ]; then
  dim "  ${dirty_count} dirty, ${clean_count} clean"; echo ""
else
  dim "  ${dirty_count} dirty, ${clean_count} clean (use --all to show clean repos)"; echo ""
fi
echo ""
dim "  ↑ ahead  ↓ behind  ● staged  ✎ modified  ? untracked"; echo ""
