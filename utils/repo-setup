#!/usr/bin/env bash
# repo-setup — Apply standard GitHub labels and branch protection rulesets.
#
# Usage:
#   repo-setup --repo OWNER/REPO [--scenario personal|team] [OPTIONS]
#
# Options:
#   --repo OWNER/REPO       Target repository (required)
#   --scenario personal|team Branch protection scenario (default: personal)
#   --labels-only           Only set up labels, skip rulesets
#   --rulesets-only         Only set up rulesets, skip labels
#   --dry-run               Show what would happen without making changes
#   --help                  Show this help
#
# Label set (13 labels):
#   Type:      feature, bug, chore, test, question, duplicate, help wanted
#   Priority:  P0, P1, P2
#   Readiness: ready, copilot-ready
#   Status:    blocked
#
# Ruleset scenarios:
#   personal — lmoloney bypasses, PR required with 0 approvals
#   team     — no bypass, PR required with 1 approval
#
# Both scenarios block force push and restrict deletions on main.

set -euo pipefail

# --- Configuration -----------------------------------------------------------

BYPASS_USER="lmoloney"

LABELS_TO_DELETE=(
  "enhancement"
  "documentation"
  "good first issue"
  "invalid"
  "wontfix"
)

# Format: "name|color|description"
LABELS=(
  "feature|0075ca|New functionality"
  "bug|d73a4a|Something broken"
  "chore|666666|Maintenance, refactoring, deps"
  "test|bfd4f2|Test coverage"
  "question|d876e3|Discussion or clarification needed"
  "duplicate|cfd3d7|Already tracked elsewhere"
  "help wanted|008672|Open for contributions"
  "P0|b60205|Drop everything"
  "P1|d93f0b|Do this sprint/phase"
  "P2|fbca04|Backlog"
  "ready|0e8a16|Groomed, unblocked, pick it up"
  "copilot-ready|7057ff|Well-specified, safe for agent delegation"
  "blocked|e4e669|Can't proceed (reason in comment)"
)

# --- Helpers -----------------------------------------------------------------

usage() {
  sed -n '2,/^$/{ s/^# //; s/^#//; p; }' "$0"
  exit 0
}

info()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m⚠\033[0m  %s\n' "$*"; }
error() { printf '\033[1;31m✗\033[0m  %s\n' "$*" >&2; exit 1; }
ok()    { printf '\033[1;32m✓\033[0m  %s\n' "$*"; }

run() {
  if [[ "$DRY_RUN" == "true" ]]; then
    printf '\033[2m[dry-run]\033[0m %s\n' "$*"
  else
    "$@"
  fi
}

# --- Parse arguments ---------------------------------------------------------

REPO=""
SCENARIO="personal"
LABELS_ONLY="false"
RULESETS_ONLY="false"
DRY_RUN="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)        REPO="$2"; shift 2 ;;
    --scenario)    SCENARIO="$2"; shift 2 ;;
    --labels-only) LABELS_ONLY="true"; shift ;;
    --rulesets-only) RULESETS_ONLY="true"; shift ;;
    --dry-run)     DRY_RUN="true"; shift ;;
    --help|-h)     usage ;;
    *) error "Unknown option: $1" ;;
  esac
done

[[ -z "$REPO" ]] && error "Missing --repo OWNER/REPO"
[[ "$SCENARIO" != "personal" && "$SCENARIO" != "team" ]] && error "Invalid --scenario: $SCENARIO (must be personal or team)"

# Ensure gh is authenticated
GH_TOKEN="$(gh auth token --user "$BYPASS_USER" 2>/dev/null || gh auth token)" || error "Not authenticated with gh CLI"
export GH_TOKEN

info "Target: $REPO"
info "Scenario: $SCENARIO"
[[ "$DRY_RUN" == "true" ]] && warn "Dry run — no changes will be made"
echo

# --- Labels ------------------------------------------------------------------

setup_labels() {
  info "Setting up labels..."

  # Delete GitHub defaults
  for label in "${LABELS_TO_DELETE[@]}"; do
    if gh label list --repo "$REPO" --json name --jq ".[].name" 2>/dev/null | grep -qx "$label"; then
      run gh label delete "$label" --repo "$REPO" --yes && ok "Deleted: $label" || warn "Failed to delete: $label"
    fi
  done

  # Create/update standard labels
  for entry in "${LABELS[@]}"; do
    local label color description
    label="${entry%%|*}"
    local rest="${entry#*|}"
    color="${rest%%|*}"
    description="${rest#*|}"

    run gh label create "$label" \
      --repo "$REPO" \
      --color "$color" \
      --description "$description" \
      --force \
      && ok "Label: $label" || warn "Failed: $label"
  done

  echo
  ok "Labels complete"
}

# --- Rulesets ----------------------------------------------------------------

get_user_node_id() {
  local login="$1"
  gh api "users/$login" --jq '.id'
}

setup_rulesets() {
  info "Setting up branch protection ruleset (scenario: $SCENARIO)..."

  local bypass_actors="[]"
  local required_approvals=1
  local ruleset_name="protect-main"

  if [[ "$SCENARIO" == "personal" ]]; then
    local node_id
    node_id="$(get_user_node_id "$BYPASS_USER")" || error "Could not look up node_id for $BYPASS_USER"
    info "Bypass user: $BYPASS_USER ($node_id)"

    bypass_actors=$(cat <<EOF
[
      {
        "actor_id": ${node_id},
        "actor_type": "User",
        "bypass_mode": "always"
      }
    ]
EOF
)
    required_approvals=0
  fi

  local payload
  payload=$(cat <<EOF
{
  "name": "$ruleset_name",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": $bypass_actors,
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": $required_approvals,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "dismiss_stale_reviews_on_push": false,
        "required_review_thread_resolution": false
      }
    }
  ]
}
EOF
)

  if [[ "$DRY_RUN" == "true" ]]; then
    printf '\033[2m[dry-run] Would POST to repos/%s/rulesets:\033[0m\n' "$REPO"
    echo "$payload" | python3 -m json.tool 2>/dev/null || echo "$payload"
  else
    # Check for existing ruleset with same name
    local existing_id
    existing_id=$(gh api "repos/$REPO/rulesets" --jq ".[] | select(.name == \"$ruleset_name\") | .id" 2>/dev/null || true)

    if [[ -n "$existing_id" ]]; then
      info "Updating existing ruleset (id: $existing_id)..."
      echo "$payload" | gh api --method PUT "repos/$REPO/rulesets/$existing_id" --input - > /dev/null
      ok "Ruleset updated: $ruleset_name"
    else
      info "Creating new ruleset..."
      echo "$payload" | gh api --method POST "repos/$REPO/rulesets" --input - > /dev/null
      ok "Ruleset created: $ruleset_name"
    fi
  fi

  echo
  ok "Rulesets complete"
}

# --- Main --------------------------------------------------------------------

if [[ "$RULESETS_ONLY" != "true" ]]; then
  setup_labels
fi

if [[ "$LABELS_ONLY" != "true" ]]; then
  setup_rulesets
fi

echo
ok "Done! Verify at: https://github.com/$REPO/settings/rules"
