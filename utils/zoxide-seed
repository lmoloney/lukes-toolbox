#!/usr/bin/env bash
# zoxide-seed — Seed zoxide's database from shell history and project directories.
#
# Useful after a DB reset, new machine setup, or anytime zoxide feels empty.
# Adds directories with enough synthetic visits to survive zoxide's aging algorithm.
#
# Scans three tiers of directories:
#   system  — curated top-level dirs (/Applications, /opt, /tmp, /Users, /Volumes)
#   home    — direct children of $HOME
#   dev     — project repos at $SOURCE/*/*  (excludes archive/ by default)
#
# Usage:
#   zoxide-seed [OPTIONS]
#
# Options:
#   --source DIR           Root directory to scan for projects (default: ~/Developer)
#   --history FILE         Shell history file to parse (default: ~/.zsh_history)
#   --visits N             Synthetic visits per directory (default: 10)
#   --extras DIR,...       Additional directories to add (comma-separated)
#   --tiers TIER,...       Tiers to scan: system,home,dev (default: all)
#   --include-archive      Include archive/ subdirectory in dev tier
#   --quiet                Suppress all output except errors
#   --dry-run              Show what would be added without modifying the DB
#   -h, --help             Show this help

set -euo pipefail

# --- Configuration -----------------------------------------------------------

SOURCE="${HOME}/Developer"
HISTORY="${HOME}/.zsh_history"
VISITS=10
DRY_RUN=false
QUIET=false
INCLUDE_ARCHIVE=false
TIERS=("system" "home" "dev")
EXTRAS=()

SYSTEM_DIRS=(/Applications /opt /tmp /Users /Volumes)

# --- Helpers ------------------------------------------------------------------

log()  { $QUIET || printf "\033[1;34m→\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m⚠\033[0m %s\n" "$*" >&2; }
ok()   { $QUIET || printf "\033[1;32m✓\033[0m %s\n" "$*"; }
dim()  { $QUIET || printf "\033[2m  %s\033[0m\n" "$*"; }

has_tier() { local t; for t in "${TIERS[@]}"; do [[ "$t" == "$1" ]] && return 0; done; return 1; }

usage() {
    sed -n '2,/^$/{ s/^# //; s/^#//; p }' "$0"
    exit 0
}

# --- Argument parsing ---------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case "$1" in
        --source)            SOURCE="$2"; shift 2 ;;
        --history)           HISTORY="$2"; shift 2 ;;
        --visits)            VISITS="$2"; shift 2 ;;
        --extras)            IFS=',' read -ra EXTRAS <<< "$2"; shift 2 ;;
        --tiers)             IFS=',' read -ra TIERS <<< "$2"; shift 2 ;;
        --include-archive)   INCLUDE_ARCHIVE=true; shift ;;
        --quiet)             QUIET=true; shift ;;
        --dry-run)           DRY_RUN=true; shift ;;
        -h|--help)           usage ;;
        *)                   warn "Unknown option: $1"; usage ;;
    esac
done

# --- Preflight ----------------------------------------------------------------

if ! command -v zoxide &>/dev/null; then
    warn "zoxide is not installed — nothing to seed."
    exit 1
fi

# --- Collect directories ------------------------------------------------------

declare -A candidates  # associative array for dedup

# 0. Parse shell history for absolute cd targets
if [[ -r "$HISTORY" ]]; then
    log "Parsing shell history: $HISTORY"
    while IFS= read -r line; do
        # Extended zsh history format: : timestamp:0;command
        if [[ "$line" =~ ^:\ [0-9]+:[0-9]+\;(.+) ]]; then
            cmd="${BASH_REMATCH[1]}"
        else
            cmd="$line"
        fi
        # Extract cd targets (stop at shell metacharacters)
        while [[ "$cmd" =~ cd[[:space:]]+([^[:space:]\;\&\|]+) ]]; do
            target="${BASH_REMATCH[1]}"
            cmd="${cmd#*"${BASH_REMATCH[0]}"}"
            # Expand ~ and skip flags / relative paths
            [[ "$target" == -* || "$target" == "." || "$target" == ".." ]] && continue
            target="${target/#\~/$HOME}"
            [[ "$target" == /* ]] || continue
            # Resolve and check existence
            resolved="$(cd "$target" 2>/dev/null && pwd -P)" || continue
            candidates["$resolved"]=1
        done
    done < "$HISTORY"
    log "Found ${#candidates[@]} directories from history"
else
    warn "History file not found: $HISTORY — skipping"
fi

# 1. Tier: system — curated top-level directories
if has_tier system; then
    log "Scanning tier: system (curated /*)..."
    count_before=${#candidates[@]}
    for dir in "${SYSTEM_DIRS[@]}"; do
        [[ -d "$dir" ]] && candidates["$dir"]=1
    done
    added=$(( ${#candidates[@]} - count_before ))
    log "Found $added new system directories"
fi

# 2. Tier: home — direct children of $HOME
if has_tier home; then
    log "Scanning tier: home (~/*) ..."
    count_before=${#candidates[@]}
    for dir in "$HOME"/*/; do
        [[ -d "$dir" ]] || continue
        resolved="$(cd "$dir" && pwd -P)"
        candidates["$resolved"]=1
    done
    added=$(( ${#candidates[@]} - count_before ))
    log "Found $added new home directories"
fi

# 3. Tier: dev — project repos at $SOURCE/*/*
if has_tier dev; then
    if [[ -d "$SOURCE" ]]; then
        log "Scanning tier: dev ($SOURCE/*/*) ..."
        count_before=${#candidates[@]}
        for dir in "$SOURCE"/*/; do
            [[ -d "$dir" ]] || continue
            basename="$(basename "$dir")"
            # Skip archive/ unless --include-archive
            if [[ "$basename" == "archive" ]] && ! $INCLUDE_ARCHIVE; then
                dim "Skipping $dir (use --include-archive to include)"
                continue
            fi
            # Add the category dir itself
            resolved="$(cd "$dir" && pwd -P)"
            candidates["$resolved"]=1
            # Add each repo within the category
            for repo in "$dir"*/; do
                [[ -d "$repo" ]] || continue
                resolved="$(cd "$repo" && pwd -P)"
                candidates["$resolved"]=1
            done
        done
        added=$(( ${#candidates[@]} - count_before ))
        log "Found $added new dev directories"
    else
        warn "Source directory not found: $SOURCE — skipping"
    fi
fi

# 4. Extras from --extras flag
for extra in "${EXTRAS[@]}"; do
    extra="${extra/#\~/$HOME}"
    if [[ -d "$extra" ]]; then
        candidates["$extra"]=1
    else
        warn "Extra directory not found: $extra — skipping"
    fi
done

# --- Diff against existing zoxide DB -----------------------------------------

log "Checking existing zoxide database..."
mapfile -t existing < <(zoxide query --list 2>/dev/null || true)
declare -A known
for dir in "${existing[@]}"; do
    [[ -n "$dir" ]] && known["$dir"]=1
done

new_dirs=()
for dir in "${!candidates[@]}"; do
    [[ -z "${known[$dir]:-}" ]] && new_dirs+=("$dir")
done

IFS=$'\n' new_dirs_sorted=($(sort <<< "${new_dirs[*]}")); unset IFS

if [[ ${#new_dirs_sorted[@]} -eq 0 ]]; then
    ok "Nothing to add — zoxide already knows all ${#candidates[@]} directories."
    exit 0
fi

log "${#new_dirs_sorted[@]} new directories to add (${#existing[@]} already tracked):"
for dir in "${new_dirs_sorted[@]}"; do
    dim "$dir"
done

# --- Seed ---------------------------------------------------------------------

if $DRY_RUN; then
    warn "Dry run — no changes made. Re-run without --dry-run to seed."
    exit 0
fi

log "Adding directories ($VISITS visits each)..."
for dir in "${new_dirs_sorted[@]}"; do
    for (( i = 0; i < VISITS; i++ )); do
        zoxide add -- "$dir"
    done
done

total=$(zoxide query --list 2>/dev/null | wc -l | tr -d ' ')
ok "Done — zoxide now tracks $total directories (+${#new_dirs_sorted[@]} new)."
