# SPN credentials and Fabric workspace config for sql-spn-test.py

# Entra ID tenant
TENANT_ID=<your-entra-tenant-id>

# SPN1 — admin on the workspace, runs the role assignment and GRANT
SPN1_CLIENT_ID=<app-registration-client-id>
SPN1_CLIENT_SECRET=<client-secret>

# SPN2 — the principal being added and tested
SPN2_CLIENT_ID=<app-registration-client-id>
SPN2_CLIENT_SECRET=<client-secret>
# IMPORTANT: This is the Enterprise Application (Service Principal) Object ID,
# NOT the App Registration Object ID. Find it at:
#   Entra ID → Enterprise Applications → search app name → Object ID
SPN2_OBJECT_ID=<enterprise-app-object-id>
# Display name of the SPN2 app registration (used in GRANT statements)
SPN2_NAME=<app-display-name>

# Fabric workspace
WORKSPACE_ID=<fabric-workspace-guid>

# SQL Analytics Endpoint (e.g., abc123.datawarehouse.fabric.microsoft.com)
SQL_ENDPOINT=<sql-endpoint-hostname>

# Database display name (lakehouse or warehouse name as shown in Fabric)
DATABASE_NAME=<display-name>

# Table to query in step 5/7
SCHEMA_NAME=dbo
TABLE_NAME=<table-name>
