# Entra tenant and public client app registration
TENANT_ID=<your-entra-tenant-id>
PUBLIC_CLIENT_ID=<public-client-app-id>

# Optional, useful for interactive browser sign-in account selection
LOGIN_HINT=

# Test-only non-interactive password flow (ROPC). Do not use for production.
PUBLIC_CLIENT_USERNAME=
PUBLIC_CLIENT_PASSWORD=

# Fabric SQL Analytics Endpoint / Warehouse
# Example: abc123.datawarehouse.fabric.microsoft.com
SQL_ENDPOINT=<fabric-sql-endpoint-hostname>
DATABASE_NAME=<warehouse-or-lakehouse-name>

# interactive is the default. Use password only for controlled MFA-exempt tests.
DEFAULT_FLOW=interactive

# Local MSAL cache path. This can contain refresh tokens and is gitignored.
MSAL_CACHE_PATH=.msal_token_cache.json

# SQL login timeout in seconds. Keep this finite so TCP/firewall issues fail quickly.
SQL_LOGIN_TIMEOUT_SECONDS=30

# Optional query run after SQL identity diagnostics by `diagnose`
DEFAULT_QUERY=
